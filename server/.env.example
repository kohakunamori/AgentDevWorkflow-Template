# Copy to server/.env; chmod 600 server/.env; never commit it.
GITHUB_REPOSITORY=YOUR_USERNAME/YOUR_PROJECT
# Fine-grained PAT for only this repo: Issues read, Actions write, Metadata read.
# A GitHub App installation token is preferred for long-lived deployments.
GH_TOKEN=
CONTROLLER_DISPATCH_ENABLED=false
CONTROLLER_APPROVAL_LABEL=agent:approved
CONTROLLER_POLL_SECONDS=90
CONTROLLER_MAX_PARALLEL=2
CONTROLLER_MAX_DAILY=10
CONTROLLER_MAX_ATTEMPTS=2
CONTROLLER_RETRY_SECONDS=900
